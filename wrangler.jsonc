{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "empty-night-583f",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "account_id": "8e208744c31fc18f880f59bf18d4c645",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/ryan-hero.webp"]
  },
  "kv_namespaces": [
    {
      "binding": "SITE",
      "id": "3577f04b88e04971b986b4388b4c3e61"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
